# Copy to .env and adjust. Every value is optional in dev — sane defaults ship in settings.py.
# PRODUCTION (PythonAnywhere): DEBUG must be false, SECRET_KEY must be a real
# secret, and this file is the ONLY copy of prod secrets — back it up off-box.

# --- Core ---
SECRET_KEY=change-me-in-production
# Defaults to false. Production MUST keep it false; true exposes stack traces.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100,bubaa.pythonanywhere.com
NGROK_ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,.ngrok.io,.ngrok.app
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.io,https://*.ngrok.app
TIMEZONE=America/New_York
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=true

# Required by the ngrok service in the root Docker Compose stack (local dev only).
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken

# Flutter is configured at launch/build time, not in Dart source.
MURA_API_URL=https://your-ngrok-host.ngrok-free.app/api/v1

# --- Database (omit entirely to use local SQLite fallback) ---
DB_ENGINE=postgresql
DB_NAME=mura
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- TheFeeder (human review pipeline) ---
# Required shared secret for POST /auth/register/employee/. Unset = employee
# registration is fully disabled. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
EMPLOYEE_SIGNUP_KEY=
# Fixed secret the feeder sends as X-Service-Key to /content/items/bulk-import/.
# Unset = bulk-import endpoint disabled.
SERVICE_API_KEY=

# --- Push (Signo) ---
# The global namespace is ONLY for owner broadcasts from the studio. Personal
# events (habit streaks, goals, reminders) go to per-user topics derived as
# "{SIGNO_NAMESPACE}:{user_id}" — see SIGNO_USER_NAMESPACE_TEMPLATE in settings.py.
SIGNO_NAMESPACE=
# Devices must subscribe to the per-user topic to receive personal pushes.
SIGNO_USER_NAMESPACE_TEMPLATE={namespace}:{user_id}

# --- Push (FCM — primary channel) ---
# From Firebase console -> Project Settings -> Service accounts -> Generate
# new private key (JSON). Pushes then reach every Android phone; no extra
# app needed. Leave ALL unset to disable FCM and use Signo topics only.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
