# Copy to .env and adjust. Every value is optional in dev — sane defaults ship in settings.py.

# --- Core ---
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100
NGROK_ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,.ngrok.io,.ngrok.app
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.io,https://*.ngrok.app
TIMEZONE=America/New_York
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=true

# Required by the ngrok service in the root Docker Compose stack.
NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken

# Flutter is configured at launch/build time, not in Dart source.
MURA_API_URL=https://your-ngrok-host.ngrok-free.app/api/v1

# --- Database (omit entirely to use local SQLite fallback) ---
DB_ENGINE=postgresql
DB_NAME=mura
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- TheFeeder ---
# Google AI Studio key used by the feeder's Gemini extraction (required to process books)
GEMINI_API_KEY=
# Anthropic is optional. A key beginning sk-ant- routes extraction to Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=gemini-3.6-flash
# Fixed secret the feeder sends as X-Service-Key to /content/items/bulk-import/.
# Unset = bulk-import endpoint disabled.
SERVICE_API_KEY=
# Optional: run extraction via Celery instead of the thread fallback
# REDIS_URL=redis://127.0.0.1:6379/0
